OPENAI_API_KEY=your_real_key_here
OPENAI_MODEL=gpt-5-mini

# Usage logging is off by default because learner prompts can be sensitive.
# Turn this on only after consent/IRB procedures are ready.
USAGE_LOGGING=false
LOG_RAW_TEXT=false
REQUIRE_LOG_CONSENT=true
USAGE_LOG_DIR=logs

# RAG-first grounding. Add source text files under rag_sources/files.
RAG_ENABLED=true
RAG_SOURCES_DIR=rag_sources/files
RAG_TOP_K=3
RAG_MIN_SCORE=1.2
